# EditorConfig - Ensure consistent coding styles
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PHP files
[*.php]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf

# JavaScript files
[*.js]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf

# CSS files
[*.css]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf

# HTML files
[*.html]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf

# Markdown files
[*.md]
charset = utf-8
trim_trailing_whitespace = false
end_of_line = lf

# SQL files
[*.sql]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
